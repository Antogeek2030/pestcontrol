---
import Layout from '../../layouts/Layout.astro';
const phone = '+13615550199';
const phoneDisplay = '(361) 555-0199';
---
<Layout title="Wasp Nest Removal Victoria TX | Safe Professional Service" description="Wasp or yellow jacket nests near your home in Victoria, TX? Safe, professional removal protects your family.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → Problems → Wasp Nests</div>
      <h1>Wasp Nests</h1>
      <p>Paper wasps and yellow jackets near doors, eaves or play areas are a real safety risk. Let us remove them safely.</p>
      <a href={`tel:${phone}`} class="btn btn-primary">Call {phoneDisplay}</a>
    </div>
  </section>
  <section class="section">
    <div class="container content-block">
      <h2>Don’t Risk a Sting</h2>
      <p>Attempting to knock down a nest yourself can provoke a defensive swarm. Professional technicians use proper protective gear and products to eliminate the colony with minimal risk.</p>
      <p style="margin-top:2rem;text-align:center"><a href={`tel:${phone}`} class="btn btn-primary">Request Wasp Removal</a></p>
    </div>
  </section>
</Layout>
