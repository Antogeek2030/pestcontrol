---
import Layout from '../../layouts/Layout.astro';
const phone = '+13615550199';
const phoneDisplay = '(361) 555-0199';
---
<Layout title="Flea & Tick Control Victoria TX | Pet & Home Protection" description="Fleas or ticks in your Victoria, TX home or yard? We treat indoor and outdoor areas to break the life cycle.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → Problems → Fleas & Ticks</div>
      <h1>Fleas &amp; Ticks</h1>
      <p>Protect your pets and family. Effective treatment targets adults and the stages that keep the infestation going.</p>
      <a href={`tel:${phone}`} class="btn btn-primary">Call {phoneDisplay}</a>
    </div>
  </section>
  <section class="section">
    <div class="container content-block">
      <h2>Complete Life-Cycle Control</h2>
      <p>Fleas spend much of their life cycle off the pet — in carpets, furniture and outdoor areas. Treating only the animal leaves eggs and larvae behind. We treat the environment so the problem does not return.</p>
      <p style="margin-top:2rem;text-align:center"><a href={`tel:${phone}`} class="btn btn-primary">Get Flea &amp; Tick Help</a></p>
    </div>
  </section>
</Layout>
